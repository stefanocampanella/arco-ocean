# Default paths and settings
# Where data go (scripts/lib/common.sh): kept from the environment or the scripts' settings file,
# else under $SCRATCH, else (empty) the project's data/.
DATA_ROOT="${DATA_ROOT:-${SCRATCH:+${SCRATCH}/arco-ocean}}"
# Dask's chunk size: 256 MiB was the fastest on the project VM (arco-make logbook, 18 Nov). Set
# it here, in the environment, or in ~/.arcomakerc (DASK_ARRAY__CHUNK_SIZE=256MiB).
# DASK_ARRAY__CHUNK_SIZE=256MiB
